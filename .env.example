# Copiază în .env.local (necomis). Valorile reale se completează în Etapa 2.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Doar server — nu folosi niciodată prefixul NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Secretul joburilor (/api/jobs/*); local: local-cron-secret (setat și în Vault de seed.sql)
CRON_SECRET=
# Doar pentru testele E2E (toate cererile vin de pe localhost); în producție rămâne nesetat (20 / 5 min)
# AUTH_RATE_LIMIT_PER_IP=
